#!/usr/bin/env node

import { writeFile, unlink } from 'fs/promises';
import { tmpdir } from 'os';
import { join } from 'path';
import { spawn } from 'child_process';

const args = process.argv.slice(2);

// Show usage if no args or --help/-h flag
if (args.length === 0 || args.includes('--help') || args.includes('-h')) {
  console.log('Usage: tts-speak "Text to speak"');
  console.log('Options:');
  console.log('  -v, --voice <voice>  Voice to use (default: en-US-EmmaMultilingualNeural)');
  console.log('  -l, --list           List available voices');
  console.log('  -h, --help           Show this help message');
  process.exit(0);
}

// Check for ffplay availability
async function checkFfplay() {
  return new Promise((resolve) => {
    const check = spawn('which', ['ffplay'], { shell: false });
    check.on('close', (code) => {
      if (code !== 0) {
        console.error('Error: ffplay (from ffmpeg) is required but not found.');
        console.error('Please install ffmpeg: brew install ffmpeg (macOS) or apt install ffmpeg (Linux)');
        resolve(false);
      } else {
        resolve(true);
      }
    });
    check.on('error', () => {
      console.error('Error: ffplay (from ffmpeg) is required but not found.');
      console.error('Please install ffmpeg: brew install ffmpeg (macOS) or apt install ffmpeg (Linux)');
      resolve(false);
    });
  });
}

// Check for edge-tts-universal availability
async function checkEdgeTTS() {
  try {
    await import('edge-tts-universal');
    return true;
  } catch (e) {
    console.error('Error: edge-tts-universal package is required but not found.');
    console.error('Please install it with: npm install edge-tts-universal');
    return false;
  }
}

const listVoices = args.includes('-l') || args.includes('--list');

if (listVoices) {
  // Check dependencies before listing voices
  if (!await checkEdgeTTS()) {
    process.exit(1);
  }
  
  const { listVoicesUniversal } = await import('edge-tts-universal');
  const voices = await listVoicesUniversal();
  console.log('Available voices:');
  voices.forEach(v => {
    console.log(`  ${v.Name}: ${v.Locale} - ${v.Gender}`);
  });
  process.exit(0);
}

let text = args[0];
let voice = 'en-US-EmmaMultilingualNeural';

// Parse args
for (let i = 1; i < args.length; i++) {
  if ((args[i] === '-v' || args[i] === '--voice') && args[i + 1]) {
    voice = args[i + 1];
    i++;
  }
}

async function speak(text, voice) {
  // Check dependencies before speaking
  if (!await checkFfplay()) {
    process.exit(1);
  }
  if (!await checkEdgeTTS()) {
    process.exit(1);
  }
  
  const { UniversalEdgeTTS } = await import('edge-tts-universal');
  
  console.log(`Speaking: "${text}" with voice: ${voice}`);
  
  const tts = new UniversalEdgeTTS(text, voice);
  const result = await tts.synthesize();
  
  // Convert Blob to Buffer
  const arrayBuffer = await result.audio.arrayBuffer();
  const audioData = Buffer.from(arrayBuffer);
  
  const tempFile = join(tmpdir(), `tts-${Date.now()}.mp3`);
  await writeFile(tempFile, Buffer.from(audioData));
  
  console.log(`Audio saved to: ${tempFile}`);
  
  // Play audio using ffplay (from ffmpeg)
  const player = spawn('ffplay', ['-nodisp', '-autoexit', '-loglevel', 'quiet', tempFile]);
  
  player.on('close', async () => {
    try {
      await unlink(tempFile);
    } catch (e) {}
    process.exit(0);
  });
  
  player.on('error', (err) => {
    console.error('Error playing audio:', err.message);
    process.exit(1);
  });
}

speak(text, voice).catch(err => {
  console.error('Error:', err.message);
  process.exit(1);
});
