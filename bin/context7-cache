#!/usr/bin/env bash
#
# Context7 Cache Manager CLI
# Manages local cache of Context7 documentation with TTL
#

set -e

CACHE_DIR="${HOME}/.factory/cache/context7"
METADATA_FILE="${CACHE_DIR}/.metadata.json"
DEFAULT_TTL=86400  # 24 hours in seconds

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Ensure cache directory exists
mkdir -p "$CACHE_DIR"

# Initialize metadata if not exists
if [[ ! -f "$METADATA_FILE" ]]; then
    echo '{"entries": {}, "stats": {"hits": 0, "misses": 0}}' > "$METADATA_FILE"
fi

# Sanitize library ID to filename
sanitize_id() {
    echo "$1" | sed 's/\//_/g' | sed 's/^_//'
}

# Get cached entry
cache_get() {
    local library_id="$1"
    local filename=$(sanitize_id "$library_id")
    local cache_file="${CACHE_DIR}/${filename}.json"
    
    if [[ ! -f "$cache_file" ]]; then
        # Update miss count
        python3 - "$METADATA_FILE" "$library_id" <<'PY'
import json, sys
metadata_file, lib_id = sys.argv[1], sys.argv[2]
with open(metadata_file, 'r+') as f:
    data = json.load(f)
    data['stats']['misses'] = data['stats'].get('misses', 0) + 1
    f.seek(0)
    json.dump(data, f, indent=2)
    f.truncate()
PY
        echo -e "${YELLOW}Cache miss${NC}: $library_id"
        return 1
    fi
    
    # Check TTL
    local cached_at=$(python3 -c "import json; print(json.load(open('$cache_file'))['cached_at'])")
    local ttl=$(python3 -c "import json; print(json.load(open('$cache_file'))['ttl_seconds'])")
    local now=$(date +%s)
    local cached_ts=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$cached_at" +%s 2>/dev/null || echo "0")
    
    if [[ $((cached_ts + ttl)) -lt $now ]]; then
        echo -e "${YELLOW}Cache expired${NC}: $library_id"
        rm "$cache_file"
        return 1
    fi
    
    # Update hit count
    python3 - "$METADATA_FILE" "$library_id" <<'PY'
import json, sys
metadata_file, lib_id = sys.argv[1], sys.argv[2]
with open(metadata_file, 'r+') as f:
    data = json.load(f)
    data['stats']['hits'] = data['stats'].get('hits', 0) + 1
    f.seek(0)
    json.dump(data, f, indent=2)
    f.truncate()
PY
    
    echo -e "${GREEN}Cache hit${NC}: $library_id"
    cat "$cache_file"
}

# Set cache entry
cache_set() {
    local library_id="$1"
    local data="$2"
    local ttl="${3:-$DEFAULT_TTL}"
    local filename=$(sanitize_id "$library_id")
    local cache_file="${CACHE_DIR}/${filename}.json"
    
    local size=$(echo "$data" | wc -c | tr -d ' ')
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    
    cat > "$cache_file" <<EOF
{
  "library_id": "$library_id",
  "data": $data,
  "cached_at": "$timestamp",
  "ttl_seconds": $ttl,
  "size_bytes": $size
}
EOF
    
    # Update metadata
    python3 - "$METADATA_FILE" "$library_id" "$timestamp" "$ttl" "$size" <<'PY'
import json, sys
metadata_file, lib_id, ts, ttl, size = sys.argv[1:]
with open(metadata_file, 'r+') as f:
    data = json.load(f)
    data['entries'][lib_id] = {
        'cached_at': ts,
        'ttl_seconds': int(ttl),
        'size_bytes': int(size)
    }
    f.seek(0)
    json.dump(data, f, indent=2)
    f.truncate()
PY
    
    echo -e "${GREEN}Cached${NC}: $library_id (${size} bytes, TTL: ${ttl}s)"
}

# List cached entries
cache_list() {
    echo -e "${BLUE}Cached Libraries:${NC}"
    echo ""
    
    if [[ ! -d "$CACHE_DIR" ]] || [[ -z "$(ls -A $CACHE_DIR 2>/dev/null | grep -v metadata)" ]]; then
        echo "  No cached entries"
        return 0
    fi
    
    for file in "$CACHE_DIR"/*.json; do
        [[ "$file" == *".metadata.json"* ]] && continue
        [[ ! -f "$file" ]] && continue
        
        local lib_id=$(python3 -c "import json; print(json.load(open('$file'))['library_id'])" 2>/dev/null)
        local cached_at=$(python3 -c "import json; print(json.load(open('$file'))['cached_at'])" 2>/dev/null)
        local size=$(python3 -c "import json; print(json.load(open('$file'))['size_bytes'])" 2>/dev/null)
        local ttl=$(python3 -c "import json; print(json.load(open('$file'))['ttl_seconds'])" 2>/dev/null)
        
        local now=$(date +%s)
        local cached_ts=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$cached_at" +%s 2>/dev/null || echo "0")
        local expires=$((cached_ts + ttl))
        local remaining=$((expires - now))
        
        if [[ $remaining -gt 0 ]]; then
            local hours=$((remaining / 3600))
            echo -e "  ${GREEN}●${NC} $lib_id (${size}b, expires in ${hours}h)"
        else
            echo -e "  ${RED}●${NC} $lib_id (${size}b, EXPIRED)"
        fi
    done
}

# Show cache stats
cache_stats() {
    echo -e "${BLUE}Context7 Cache Statistics:${NC}"
    echo ""
    
    python3 - "$METADATA_FILE" <<'PY'
import json, os, sys
from pathlib import Path

metadata_file = sys.argv[1]
cache_dir = Path(metadata_file).parent

with open(metadata_file) as f:
    data = json.load(f)

stats = data.get('stats', {})
entries = data.get('entries', {})

hits = stats.get('hits', 0)
misses = stats.get('misses', 0)
total = hits + misses
hit_rate = (hits / total * 100) if total > 0 else 0

# Calculate total cache size
total_size = 0
for f in cache_dir.glob('*.json'):
    if f.name != '.metadata.json':
        total_size += f.stat().st_size

print(f"  Entries: {len(entries)}")
print(f"  Total size: {total_size / 1024:.1f} KB")
print(f"  Hits: {hits}")
print(f"  Misses: {misses}")
print(f"  Hit rate: {hit_rate:.1f}%")
PY
}

# Clear cache
cache_clear() {
    local all=false
    local expired=false
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all) all=true ;;
            --expired) expired=true ;;
        esac
        shift
    done
    
    if [[ "$all" == "true" ]]; then
        rm -f "$CACHE_DIR"/*.json 2>/dev/null || true
        echo '{"entries": {}, "stats": {"hits": 0, "misses": 0}}' > "$METADATA_FILE"
        echo -e "${GREEN}Cleared all cache${NC}"
        return 0
    fi
    
    if [[ "$expired" == "true" ]]; then
        local count=0
        for file in "$CACHE_DIR"/*.json; do
            [[ "$file" == *".metadata.json"* ]] && continue
            [[ ! -f "$file" ]] && continue
            
            local cached_at=$(python3 -c "import json; print(json.load(open('$file'))['cached_at'])" 2>/dev/null)
            local ttl=$(python3 -c "import json; print(json.load(open('$file'))['ttl_seconds'])" 2>/dev/null)
            local now=$(date +%s)
            local cached_ts=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$cached_at" +%s 2>/dev/null || echo "0")
            
            if [[ $((cached_ts + ttl)) -lt $now ]]; then
                rm "$file"
                ((count++))
            fi
        done
        echo -e "${GREEN}Cleared $count expired entries${NC}"
        return 0
    fi
    
    echo "Usage: context7-cache clear [--all|--expired]"
    return 1
}

# Main CLI
case "${1:-}" in
    get) cache_get "$2" ;;
    set) cache_set "$2" "$3" "${4:-}" ;;
    list) cache_list ;;
    stats) cache_stats ;;
    clear) cache_clear "${@:2}" ;;
    *)
        echo "Context7 Cache Manager"
        echo ""
        echo "Usage:"
        echo "  context7-cache get <library_id>         Get cached docs"
        echo "  context7-cache set <library_id> <json>  Cache docs (optional: ttl_seconds)"
        echo "  context7-cache list                     List cached entries"
        echo "  context7-cache stats                    Show cache statistics"
        echo "  context7-cache clear [--all|--expired]  Clear cache"
        ;;
esac
